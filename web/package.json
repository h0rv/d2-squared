{
  "name": "d2-squared-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "build:embed": "vite build --mode embed",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:serve": "playwright test --project=serve",
    "test:wasm": "playwright test --project=wasm",
    "test:chrome": "playwright test --project=wasm --project=serve",
    "test:firefox": "playwright test --project=wasm-firefox --project=serve-firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
